<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Zakonsko jamstvo – najmanje 2 godine (Basel)</name>
	<code>agmedia_legal_guarantee_basel_oc3</code>
	<version>1.1.0</version>
	<author>AG media</author>
	<link>https://www.agmedia.hr</link>

	<file path="catalog/controller/common/footer.php">
		<operation error="abort">
			<search><![CDATA[$data['newsletter'] = $this->url->link('account/newsletter', '', true);]]></search>
			<add position="after"><![CDATA[
		$data = array_merge($this->load->language('extension/module/legal_guarantee'), $data);
		$data['legal_guarantee_url'] = 'https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_hr.htm';
		$data['legal_guarantee_notice_svg'] = 'catalog/view/theme/basel/image/legal-guarantee/legal-guarantee-notice-hr.svg';
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/basel/template/common/header.twig">
		<operation error="abort">
			<search><![CDATA[<!-- Mandatory Theme Settings CSS -->]]></search>
			<add position="before"><![CDATA[
<link href="catalog/view/theme/basel/stylesheet/legal-guarantee.css?v=1.1.0" rel="stylesheet" />
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/basel/template/common/footer.twig">
		<operation error="abort">
			<search><![CDATA[<div id="footer">]]></search>
			<add position="before"><![CDATA[
<div class="legal-guarantee-bar primary-color-border">
  <div class="container">
    <a class="legal-guarantee-trigger btn btn-primary" href="{{ legal_guarantee_url }}" data-toggle="modal" data-target="#legal-guarantee-modal" aria-controls="legal-guarantee-modal" aria-haspopup="dialog">
      <i class="fa fa-shield" aria-hidden="true"></i>
      <span>{{ text_legal_guarantee }}</span>
      <i class="fa fa-angle-right" aria-hidden="true"></i>
    </a>
  </div>
</div>
			]]></add>
		</operation>
		<operation error="abort">
			<search><![CDATA[<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" />]]></search>
			<add position="before"><![CDATA[
<div class="modal fade legal-guarantee-modal" id="legal-guarantee-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="legal-guarantee-modal-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="{{ text_legal_guarantee_close }}"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="legal-guarantee-modal-title">{{ text_legal_guarantee_title }}</h4>
      </div>
      <div class="modal-body">
        <div class="legal-guarantee-notice-frame" tabindex="0" role="region" aria-label="{{ text_legal_guarantee_notice_alt }}">
          <a href="{{ legal_guarantee_notice_svg }}" target="_blank" rel="noopener" aria-label="{{ text_legal_guarantee_open_full }}">
            <img src="{{ legal_guarantee_notice_svg }}" alt="{{ text_legal_guarantee_notice_alt }}" width="595" height="842" loading="lazy" decoding="async" />
          </a>
        </div>
        <p class="legal-guarantee-more">
          <a class="primary-color" href="{{ legal_guarantee_url }}" target="_blank" rel="noopener noreferrer">{{ text_legal_guarantee_more }} <i class="fa fa-external-link" aria-hidden="true"></i></a>
        </p>
      </div>
    </div>
  </div>
</div>
			]]></add>
		</operation>
	</file>

	<file path="catalog/controller/extension/quickcheckout/terms.php">
		<operation error="skip">
			<search><![CDATA[$data = array_merge($data, $this->load->language('extension/quickcheckout/checkout'));]]></search>
			<add position="after"><![CDATA[
		$data = array_merge($data, $this->load->language('extension/module/legal_guarantee'));
		$data['legal_guarantee_url'] = 'https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_hr.htm';
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/basel/template/extension/quickcheckout/terms.twig">
		<operation error="skip">
			<search><![CDATA[<div class="terms">]]></search>
			<add position="after"><![CDATA[
  <div class="legal-guarantee-checkout primary-color-border">
    <a class="btn btn-primary btn-sm" href="{{ legal_guarantee_url }}" data-toggle="modal" data-target="#legal-guarantee-modal" aria-controls="legal-guarantee-modal" aria-haspopup="dialog"><i class="fa fa-shield" aria-hidden="true"></i>{{ text_legal_guarantee }}</a>
  </div>
			]]></add>
		</operation>
	</file>

	<file path="catalog/controller/checkout/payment_method.php">
		<operation error="skip">
			<search><![CDATA[$data['scripts'] = $this->document->getScripts();]]></search>
			<add position="after"><![CDATA[
		$data = array_merge($this->load->language('extension/module/legal_guarantee'), $data);
		$data['legal_guarantee_url'] = 'https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_hr.htm';
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/default/template/checkout/payment_method.twig">
		<operation error="skip">
			<search><![CDATA[{% if text_agree %}]]></search>
			<add position="before"><![CDATA[
<div class="legal-guarantee-checkout primary-color-border">
  <a class="btn btn-primary btn-sm" href="{{ legal_guarantee_url }}" target="_blank" rel="noopener noreferrer"><i class="fa fa-shield" aria-hidden="true"></i>{{ text_legal_guarantee }}</a>
</div>
			]]></add>
		</operation>
	</file>

	<file path="catalog/controller/product/product.php">
		<operation error="abort">
			<search><![CDATA[$data['text_login'] = sprintf($this->language->get('text_login'), $this->url->link('account/login', '', true), $this->url->link('account/register', '', true));]]></search>
			<add position="after"><![CDATA[
			$data = array_merge($this->load->language('extension/module/legal_guarantee'), $data);
			$data['legal_guarantee_url'] = 'https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_hr.htm';
			$data['withdrawal_url'] = $this->url->link('extension/account/contract_withdrawal', '', true);
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/basel/template/product/product.twig">
		<operation error="abort">
			<search><![CDATA[</div> <!-- #product ends -->]]></search>
			<add position="after"><![CDATA[
          <div class="product-legal-links">
            <a class="product-legal-link btn btn-primary btn-sm" href="{{ legal_guarantee_url }}" data-toggle="modal" data-target="#legal-guarantee-modal" aria-controls="legal-guarantee-modal" aria-haspopup="dialog"><i class="fa fa-shield" aria-hidden="true"></i>{{ text_legal_guarantee }}</a>
            <a class="product-legal-link btn btn-default btn-sm" href="{{ withdrawal_url }}"><i class="fa fa-undo" aria-hidden="true"></i>{{ text_withdrawal_14_days }}</a>
          </div>
			]]></add>
		</operation>
	</file>

	<file path="catalog/controller/mail/order.php">
		<operation error="skip">
			<search><![CDATA[$language->load('mail/order_add');]]></search>
			<add position="after"><![CDATA[
		$language->load('extension/module/legal_guarantee');
			]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[$data['text_total'] = $language->get('text_total');]]></search>
			<add position="after"><![CDATA[
		$data['text_legal_guarantee'] = $language->get('text_legal_guarantee');
		$data['text_legal_guarantee_more'] = $language->get('text_legal_guarantee_more');
		$data['legal_guarantee_url'] = 'https://europa.eu/youreurope/citizens/consumers/shopping/guarantees/index_hr.htm';
		$data['legal_guarantee_notice_image'] = rtrim($order_info['store_url'], '/') . '/catalog/view/theme/basel/image/legal-guarantee/legal-guarantee-notice-hr.png';
		$legal_guarantee_notice_file = DIR_APPLICATION . 'view/theme/basel/image/legal-guarantee/legal-guarantee-notice-hr.png';
			]]></add>
		</operation>
		<operation error="skip">
			<search><![CDATA[$mail->setHtml($this->load->view('mail/order_add', $data));]]></search>
			<add position="after"><![CDATA[
		if (is_file($legal_guarantee_notice_file)) {
			$mail->addAttachment($legal_guarantee_notice_file);
		}
			]]></add>
		</operation>
	</file>

	<file path="catalog/view/theme/default/template/mail/order_add.twig">
		<operation error="skip">
			<search><![CDATA[<p style="margin-top: 0px; margin-bottom: 20px;">{{ text_footer }}</p>]]></search>
			<add position="before"><![CDATA[
  <table style="border-collapse: collapse; width: 100%; border: 1px solid #cce9e7; background-color: #eef8f7; margin-bottom: 20px;">
    <tbody>
      <tr>
        <td style="font-size: 12px; text-align: left; padding: 14px; color: #222222;">
          <p style="margin-top: 0; margin-bottom: 12px;"><strong>{{ text_legal_guarantee }}</strong></p>
          <p style="margin-top: 0; margin-bottom: 12px; text-align: center;">
            <a href="{{ legal_guarantee_url|e('html_attr') }}" target="_blank" rel="noopener noreferrer"><img src="{{ legal_guarantee_notice_image|e('html_attr') }}" width="620" alt="{{ text_legal_guarantee|e('html_attr') }}" style="display: block; width: 100%; max-width: 620px; height: auto; margin: 0 auto; border: 0;" /></a>
          </p>
          <p style="margin: 0;">{{ text_legal_guarantee_more }} <a href="{{ legal_guarantee_url|e('html_attr') }}" target="_blank" rel="noopener noreferrer">{{ legal_guarantee_url }}</a></p>
        </td>
      </tr>
    </tbody>
  </table>
			]]></add>
		</operation>
	</file>
</modification>
