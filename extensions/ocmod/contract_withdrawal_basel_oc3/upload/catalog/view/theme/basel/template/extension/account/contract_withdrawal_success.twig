{{ header }}
<div id="account-contract-withdrawal-success" class="container contract-withdrawal-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text|e }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1 id="page-title">{{ text_success_title|e }}</h1>
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_success_message|e }}</div>

      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-file-text-o"></i> {{ text_reference|e }} #{{ contract_withdrawal_id|e }}</h3>
        </div>
        <div class="panel-body">
          <div class="table-responsive">
            <table class="table table-bordered">
              <tbody>
                <tr>
                  <td><b>{{ text_reference|e }}</b></td>
                  <td>#{{ contract_withdrawal_id|e }}</td>
                </tr>
                <tr>
                  <td><b>{{ entry_order_id|e }}</b></td>
                  <td>#{{ order_id|e }}</td>
                </tr>
                <tr>
                  <td><b>{{ entry_email|e }}</b></td>
                  <td>{{ email|e }}</td>
                </tr>
                <tr>
                  <td><b>{{ text_submitted|e }}</b></td>
                  <td>{{ date_submitted|e }}</td>
                </tr>
                <tr>
                  <td><b>{{ text_status|e }}</b></td>
                  <td>{{ status|e }}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3>{{ text_statement|e }}</h3>
          <pre class="contract-withdrawal-statement">{{ statement|e }}</pre>

          <div class="buttons clearfix">
            <a href="{{ account|e }}" class="btn btn-default pull-left"><i class="fa fa-user"></i> {{ text_back_account|e }}</a>
            <a href="{{ continue|e }}" class="btn btn-primary pull-right">{{ text_continue|e }} <i class="fa fa-angle-right"></i></a>
          </div>
        </div>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
