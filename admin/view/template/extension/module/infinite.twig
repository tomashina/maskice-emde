{{ header }}{{ column_left }}
<div id="content">
<style type="text/css">
.animation-wrapper strong {
	display: inline-block;
	padding: 10px;
	color: #aaa;
}
.animation-wrapper label span {
	display: inline-block;
	padding: 5px;
	margin: 5px;
	background-color: #fafafa;
	transition: 0.5s all;
	cursor: pointer;
}
.animation-wrapper label input:checked + span {
	background-color: #4cb64c;
	color: #fff;
}
.animation-wrapper label input {
  display: none;
}
.animation-wrapper p {
	border-bottom: 1px dashed #aaa;
}
.text-help {
	margin-top: 10px;
}
</style>
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <button id="apply" data-toggle="tooltip" title="{{ button_apply }}" class="btn btn-success"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_infinite_status" id="input-status" class="form-control">
                {% if module_infinite_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-method">{{ entry_method }}</label>
            <div class="col-sm-10">
              <select name="module_infinite_method" id="input-method" class="form-control">
                <option value="scroll" {% if module_infinite_method == 'scroll' %}selected="selected"{% endif %}>{{ text_scroll }}</option>
                <option value="button" {% if module_infinite_method == 'button' %}selected="selected"{% endif %}>{{ text_button1 }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-update">{{ entry_update }}</label>
            <div class="col-sm-10">
              <select name="module_infinite_update" id="input-update" class="form-control">
                {% if module_infinite_update %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-mobile">{{ entry_mobile }}</label>
            <div class="col-sm-10">
              <select name="module_infinite_mobile" id="input-mobile" class="form-control">
                {% if module_infinite_mobile %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-hide">{{ entry_hide }}</label>
            <div class="col-sm-10">
              <select name="module_infinite_hide" id="input-hide" class="form-control">
                {% if module_infinite_hide %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-route">{{ entry_route }}</label>
            <div class="col-sm-10">
              <textarea rows="10" name="module_infinite_route" id="input-route" class="form-control" placeholder="{{ entry_route }}">{{ module_infinite_route }}</textarea>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-class">{{ entry_class }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_class" id="input-class" class="form-control" placeholder="{{ entry_class }}" value="{{ module_infinite_class }}" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-css">{{ entry_css }}</label>
            <div class="col-sm-10">
              <textarea rows="10" name="module_infinite_css" id="input-css" class="form-control" placeholder="{{ entry_css }}">{{ module_infinite_css }}</textarea>
							<p class="text-help">{{ help_css }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-js">{{ entry_js }}</label>
            <div class="col-sm-10">
              <textarea rows="10" name="module_infinite_js" id="input-js" class="form-control" placeholder="{{ entry_js }}">{{ module_infinite_js }}</textarea>
							<p class="text-help">{{ help_js }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-product">{{ entry_product }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_product" id="input-product" value="{{ module_infinite_product }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-wrapper">{{ entry_wrapper }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_wrapper" id="input-wrapper" value="{{ module_infinite_wrapper }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pagination">{{ entry_pagination }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_pagination" id="input-pagination" value="{{ module_infinite_pagination }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-active">{{ entry_active }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_active" id="input-active" value="{{ module_infinite_active }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-threshold">{{ entry_threshold }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_infinite_threshold" id="input-threshold" value="{{ module_infinite_threshold }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-animation">{{ entry_animation }}</label>
            <div class="col-sm-10 animation-wrapper">
							<label><input name="module_infinite_animation" value="0" type="radio" {% if not module_infinite_animation %}checked="checked"{% endif %} /><span>{{ text_none }}</span></label>
							{% for group, animation in animations %}
								<p>
									<strong>{{ group }}</strong>
									{% for animation in animation %}
										<label data-animation="{{ animation }}"><input name="module_infinite_animation" value="{{ animation }}" type="radio" {% if animation == module_infinite_animation %}checked="checked"{% endif %} /><span>{{ animation }}</span></label>
									{% endfor %}
								</p>
							{% endfor %}
            </div>
          </div>
					<ul class="nav nav-tabs" id="language">
						{% for language in languages %}
						<li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
						{% endfor %}
					</ul>
					<div class="tab-content">
						{% for language in languages %}
						<div class="tab-pane" id="language{{ language.language_id }}">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-loading{{ language.language_id }}">{{ entry_loading }}</label>
								<div class="col-sm-10">
									<textarea name="module_infinite_message[{{ language.language_id }}][loading]" placeholder="{{ entry_loading }}" id="input-loading{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ module_infinite_message[language.language_id] is defined ? module_infinite_message[language.language_id].loading : text_loading }}</textarea>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-button{{ language.language_id }}">{{ entry_button }}</label>
								<div class="col-sm-10">
									<textarea name="module_infinite_message[{{ language.language_id }}][button]" placeholder="{{ entry_button }}" id="input-button{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ module_infinite_message[language.language_id] is defined ? module_infinite_message[language.language_id].button : text_button }}</textarea>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-finished{{ language.language_id }}">{{ entry_finished }}</label>
								<div class="col-sm-10">
									<textarea name="module_infinite_message[{{ language.language_id }}][finished]" placeholder="{{ entry_finished }}" id="input-finished{{ language.language_id }}" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ module_infinite_message[language.language_id] is defined ? module_infinite_message[language.language_id].finished : text_finished }}</textarea>
								</div>
							</div>
						</div>
						{% endfor %}
					</div>
        </form>
      </div>
    </div>
  </div>
</div>
<link href="view/stylesheet/animate.min.css" rel="stylesheet" />
<link href="view/javascript/codemirror/lib/codemirror.css" rel="stylesheet" />
<link href="view/javascript/codemirror/theme/monokai.css" rel="stylesheet" />
<link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/codemirror/lib/codemirror.js"></script>
<script type="text/javascript" src="view/javascript/codemirror/lib/xml.js"></script>
<script type="text/javascript" src="view/javascript/codemirror/lib/formatting.js"></script>
<script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
<script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
<script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
<script type="text/javascript"><!--
$('#apply').on('click', function() {
	$('.alert-success').remove();
  $.ajax({
    type: 'post',
    url: $('#form-module').attr('action') + '&apply=true',
    data: $('#form-module').serialize(),
    beforeSend: function() {
      $('#form-module').fadeTo('slow', 0.3);
      $('#apply').button('loading');
    },
    complete: function() {
      $('#form-module').fadeTo('slow', 1);
      $('#apply').button('reset');
    },
    success: function() {
      $('.breadcrumb').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ text_success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
    }
  });
});
$('[data-animation]').on('click', function(){
	$(this).addClass('animated ' + $(this).data('animation'));
});
$('[data-animation]').bind("animationend webkitAnimationEnd oAnimationEnd MSAnimationEnd",function(){
	$(this).removeAttr('class');
});
$('#language a:first').tab('show');
//--></script>
{{ footer }}